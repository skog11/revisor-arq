# ── Supabase ──────────────────────────────────────────────────────────────────
# Obtener en: https://supabase.com/dashboard/project/[tu-proyecto]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Cadena de LLM (todos gratuitos — ver LLM_PRIMARY más abajo) ────────────────
# Orden por defecto: Mistral* → Gemini (1 retry) → OpenRouter → Groq
# (*) Mistral es opcional: sin su API key, la cadena la salta sola.

# Gemini (Google AI Studio) — obligatorio, se usa también para HyDE/clasificador
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# Mistral (primario gratuito) — tier "Experiment" sin tarjeta (solo verificación
# telefónica), ~1B tokens/mes. Obtener en: https://console.mistral.ai
MISTRAL_API_KEY=

# OpenRouter (fallback, modelos :free) — Obtener en: https://openrouter.ai
OPENROUTER_API_KEY=

# Groq (último fallback, ultrarrápido) ─ Obtener en: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# LLM_PRIMARY: "mistral" (default) o "gemini" — decide qué proveedor va primero
LLM_PRIMARY=mistral

# ── Voyage AI (embeddings) ────────────────────────────────────────────────────
# Obtener en: https://www.voyageai.com/
VOYAGE_API_KEY=pa-...

# ── Admin ─────────────────────────────────────────────────────────────────────
# Clave secreta para acceder al panel /normativa (elige una cadena larga aleatoria)
# Generar con: openssl rand -hex 32
ADMIN_SECRET=cambia-esto-por-una-clave-segura

# ── Cron Jobs ─────────────────────────────────────────────────────────────────
# Secret para autenticar llamadas de Vercel Cron a /api/cron/*
# Vercel lo envía automáticamente como: Authorization: Bearer <CRON_SECRET>
# Generar con: openssl rand -hex 32
# Configurar también en: Vercel Dashboard → Project Settings → Environment Variables
CRON_SECRET=cambia-esto-por-una-clave-segura

# ── App URL ───────────────────────────────────────────────────────────────────
# En desarrollo: http://localhost:3000
# En producción: https://tu-dominio.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
